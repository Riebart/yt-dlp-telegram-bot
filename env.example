# Copy this file to .env and fill in your values.

# Required: your bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Optional: comma-separated list of Telegram user/chat IDs allowed to use the bot.
# Leave blank to allow everyone (not recommended on a public bot).
ALLOWED_CHAT_IDS=123456789,987654321

# Maximum file size Telegram will accept (MiB). Hard limit is 50 for the public Bot API.
MAX_SIZE_MB=50

# Target size (MiB) for the ffmpeg re-encode pass when a video exceeds MAX_SIZE_MB.
COMPRESS_MB=45

# Audio bitrate (bps) reserved when calculating the video bitrate for compression.
AUDIO_BPS=64000

# yt-dlp download timeout in seconds.
DOWNLOAD_TIMEOUT=3600

# Minimum video bitrate (kbps) when calculating compression.
MIN_VIDEO_BITRATE_KBPS=1000

# Duration in minutes to pre-check before starting expensive operations.
PREFLIGHT_DURATION_MIN=15

# Directory containing ffmpeg and ffprobe binaries.
# Leave blank to use whatever is on $PATH.
FFMPEG_LOCATION=

# Optional: persist a copy of every downloaded file to this directory.
# Leave blank to disable. In Docker, mount this path as a volume.
SAVE_DIR=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Ollama Configuration ---

# Model to use for intent classification.
OLLAMA_MODEL=qwen3.5:0.8b

# Host and port for the Ollama API.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LISTEN_TCP_HOST=127.0.0.1
OLLAMA_LISTEN_TCP_PORT=11434

# Timeout for Ollama API requests in seconds.
OLLAMA_TIMEOUT=60

# Path to the Ollama unix socket. Used by entrypoint relay.
OLLAMA_UNIX_SOCK=/run/ollama.sock
